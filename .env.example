# 服务端口号
PORT=3000

# 短信服务商：console（本地调试，只打印验证码）| aliyun（阿里云短信）
SMS_PROVIDER=console

# 固定手机号+验证码（调试专用），匹配该号码时会跳过随机生成
SMS_FIXED_PHONE=17391706252
SMS_FIXED_CODE=000000

# 阿里云短信配置（SMS_PROVIDER=aliyun 时必填）
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_REGION_ID=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=你的短信签名
ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxx

# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret
